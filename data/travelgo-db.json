  "faqs": [
    {
      "id": "4f4ce72c-9485-42fc-9b56-42b04dde3c55",
      "question": "How does per-km outstation billing work?",
      "answer": "Outstation chauffeur trips use a standard minimum of 250 km per calendar day multiplied by the vehicle per-km rate, plus a fixed daily driver allowance. State border taxes and highway tolls are billed strictly at actuals with FASTag receipts.",
      "sort_order": 1,
      "is_active": true
    },
    {
      "id": "2e64dc5f-c8c1-4315-80a2-d8de7adeb68d",
      "question": "What documents do I need for a self-drive SUV?",
      "answer": "You need an original Indian driving licence (or valid International Driving Permit with passport) and Aadhaar card or Passport for quick digital KYC verification at vehicle handover.",
      "sort_order": 2,
      "is_active": true
    },
    {
      "id": "8a6e50e9-1c09-4488-aeba-6d62b75ca49b",
      "question": "Are your vehicles permitted across all Indian states?",
      "answer": "Yes. Every TravelGo vehicle carries an All-India Tourist Permit (AITP), comprehensive passenger insurance, and active FASTag.",
      "sort_order": 3,
      "is_active": true
    },
    {
      "id": "cc83d1f0-212a-46d2-93a9-0c2d4645e6f1",
      "question": "Do I pay the full amount online when submitting a booking request?",
      "answer": "No. Submitting a booking request reserves your preference at zero charge. Our trip specialist confirms availability and sends an itemized quotation before you pay a small confirmation advance.",
      "sort_order": 4,
      "is_active": true
    },
    {
      "id": "a0a6ff49-726e-4ac0-836c-f9875b9965b2",
      "question": "Can I customize a tour package itinerary or swap the vehicle?",
      "answer": "Absolutely. Every package itinerary can be tailored for extra nights, hotel tiers, or a preferred SUV class from our fleet—simply mention it in the booking notes or message us on WhatsApp.",
      "sort_order": 5,
      "is_active": true
    }
  ],
