      "id": "pkg-rajasthan-01",
      "name": "Royal Rajasthan Heritage Circuit",
      "destination": "Jaipur · Jodhpur · Udaipur",
      "days": 6,
      "nights": 5,
      "price": 28500,
      "pickup_location": "Jaipur Airport / Railway Station",
      "dropoff_location": "Udaipur Airport",
      "itinerary": [
        {
          "day": 1,
          "title": "Arrival in Jaipur & Pink City Walk",
          "description": "Chauffeur welcome at Jaipur, heritage haveli check-in, and evening sunset at Nahargarh Fort overlooking the Pink City."
        },
        {
          "day": 2,
          "title": "Amber Fort, Jal Mahal & City Palace",
          "description": "Guided morning ascent to Amber Fort, photo halt at Jal Mahal lake, and curated afternoon tour of Jantar Mantar."
        },
        {
          "day": 3,
          "title": "Drive to Jodhpur via Pushkar",
          "description": "Scenic expressway transfer with sacred Pushkar Lake pause, arriving at the Blue City by dusk."
        },
        {
          "day": 4,
          "title": "Mehrangarh Fort & Jaswant Thada",
          "description": "Explore towering Mehrangarh ramparts, blue-washed old lanes, and spice markets around Clock Tower."
        },
        {
          "day": 5,
          "title": "Ranakpur Marble Temples to Udaipur",
          "description": "Drive through Aravalli hills with Ranakpur Jain temple visit; sunset boat cruise on Lake Pichola."
        },
        {
          "day": 6,
          "title": "City Palace Udaipur & Departure",
          "description": "Morning walk through Jagdish Temple and Saheliyon-ki-Bari before comfortable drop-off at Udaipur Airport."
        }
      ],
      "inclusions": [
        "Private AC Innova Hycross with Chauffeur",
        "5 Nights Heritage Boutique Stays with Breakfast",
        "All State Tolls, Parking & Driver Allowance",
        "Lake Pichola Sunset Boat Ride"
      ],
      "exclusions": [
        "Monument Entry & Camera Tickets",
